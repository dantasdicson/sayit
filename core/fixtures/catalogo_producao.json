    "fields": {
      "numero": 1,
      "titulo": "Magic E: mudança do som do A",
      "descricao": "Aprenda como o E final silencioso pode modificar a pronúncia da vogal A.",
      "conteudo_teorico": "O E no final fica silencioso e pode mudar o som do A. Compare cat e cake: em cake, o A soa como seu nome em inglês. Escute e repita devagar!",
      "ordem": 1,
      "ativo": true
    }
  },
  {
    "model": "core.modulo",
    "pk": 2,
    "fields": {
      "numero": 2,
      "titulo": "Magic E: mudança do som do I",
      "descricao": "Aprenda como o E final silencioso pode modificar a pronúncia da vogal I.",
      "conteudo_teorico": "O E silencioso pode mudar o som do I. Compare kit e kite: em kite, o I soa como seu nome em inglês. Vamos ouvir a diferença?",
      "ordem": 2,
      "ativo": true
    }
  },
  {
    "model": "core.modulo",
    "pk": 3,
    "fields": {
      "numero": 3,
      "titulo": "Magic E: mudança do som do O",
      "descricao": "Aprenda como o E final silencioso pode modificar a pronúncia da vogal O.",
      "conteudo_teorico": "O E no final pode mudar o som do O sem ter um som próprio. Compare hop e hope e repita cada palavra com calma.",
      "ordem": 3,
      "ativo": true
    }
  },
  {
    "model": "core.modulo",
    "pk": 4,
    "fields": {
      "numero": 4,
      "titulo": "Magic E: mudança do som do U",
      "descricao": "Aprenda como o E final silencioso pode modificar a pronúncia da vogal U.",
      "conteudo_teorico": "O E silencioso pode mudar o som do U. Compare cub e cube, tub e tube, cut e cute. Escute cada palavra: a pronúncia também pode variar entre sotaques.",
      "ordem": 4,
      "ativo": true
    }
  },
  {
    "model": "core.modulo",
    "pk": 5,
    "fields": {
      "numero": 5,
      "titulo": "SH",
      "descricao": "Aprenda a reconhecer e pronunciar palavras que apresentam a combinação SH.",
      "conteudo_teorico": "S e H juntos fazem um som parecido com o pedido de silêncio: shhh! Procure esse som em ship e fish. Ele pode aparecer no começo ou no final.",
      "ordem": 5,
      "ativo": true
    }
  },
  {
    "model": "core.modulo",
    "pk": 6,
    "fields": {
      "numero": 6,
      "titulo": "CH",
      "descricao": "Aprenda a reconhecer e pronunciar palavras que apresentam a combinação CH.",
      "conteudo_teorico": "Nestas palavras, C e H juntos fazem um som parecido com tch. Escute chair e beach e tente repetir. Nem toda palavra com CH segue essa regra!",
      "ordem": 6,
      "ativo": true
    }
  },
  {
    "model": "core.modulo",
    "pk": 7,
    "fields": {
      "numero": 7,
      "titulo": "TH",
      "descricao": "Aprenda os dois principais sons encontrados na combinação TH.",
      "conteudo_teorico": "Para experimentar TH, coloque de leve a ponta da língua entre os dentes e sopre. Em think, a garganta não vibra; em this, ela vibra. Tente sentir a diferença!",
      "ordem": 7,
      "ativo": true
    }
  },
  {
    "model": "core.modulo",
    "pk": 8,
    "fields": {
      "numero": 8,
      "titulo": "PH",
      "descricao": "Aprenda palavras em que a combinação PH normalmente possui som de F.",
      "conteudo_teorico": "P e H juntos costumam soar como F. Escute phone e elephant e procure esse som. Duas letras podem trabalhar juntas para formar um só som!",
      "ordem": 8,
      "ativo": true
    }
  },
  {
    "model": "core.modulo",
    "pk": 9,
    "fields": {
      "numero": 9,
      "titulo": "OO",
      "descricao": "Compare diferentes sons encontrados em palavras escritas com a combinação OO.",
      "conteudo_teorico": "OO pode ter sons diferentes. Compare moon e book: a posição da boca muda, não apenas a duração do som. Ouça as palavras e repita sem pressa.",
      "ordem": 9,
      "ativo": true
    }
  },
  {
    "model": "core.modulo",
    "pk": 10,
    "fields": {
      "numero": 10,
      "titulo": "Desafio Final",
